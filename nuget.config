<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Built from lane-bot with: dotnet pack <project> -c Release -p:Version=0.1.0 -o ~/.nuget/lane-local -->
    <add key="lane-local" value="%HOME%/.nuget/lane-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="lane-local">
      <package pattern="Lane.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
