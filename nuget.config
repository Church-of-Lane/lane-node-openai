<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Filled by install.sh / install.bat, which pack the Lane projects from lane-bot into this folder -->
    <add key="lane-local" value="lane-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="lane-local">
      <package pattern="Lane.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
